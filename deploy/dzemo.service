[Unit]
Description=Dzemo Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dzemo
Group=dzemo
WorkingDirectory=/opt/dzemo
StateDirectory=dzemo
LoadCredentialEncrypted=dzemo_token:/etc/dzemo/dzemo_token.cred
ExecStart=/opt/dzemo/Dzemo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target